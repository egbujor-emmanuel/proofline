node_modules/

# Runtime state of the app under test (recreated on first run)
app/server/db/data.json

# Sealed evidence packs: large binary zips, regenerated by every run.
# Not committed -- the repo stays clonable without 6MB+ of run artifacts.
.testmuai/evidence/
.evidence/

# Kane's own guidance is to gitignore .context/ because it is single-writer
# and not git-mergeable. That is right for a team sharing one live graph,
# but wrong for a repo that someone else must be able to clone and run:
# without the requirements graph there are no ACs to map a diff onto, and
# Proofline cannot work at all. It is committed deliberately -- see README.
# Do NOT run concurrent Kane context writes against a shared checkout.

# Kane's per-account sync bookkeeping (org_id, TMS test_id/project_id).
# Proofline never reads it, and it is account-specific -- another user's
# checkout should not inherit this account's TMS identifiers.
.testmuai/tests/**/.internal/

# Local machine/session scratch, safe to drop
*.log

# Proofline's own output artifact -- regenerated every run, and it must
# not be fed back in as an analyzed "code change".
proof-report.html
